{
  "name": "netmeter",
  "version": "1.0.0",
  "description": "Lightweight Windows desktop network speed and latency monitor",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --check src/main.js src/preload.js src/renderer.js src/network/adapter-monitor.js src/network/latency-monitor.js src/network/speed-calculator.js src/settings/settings-service.js src/utils/format-speed.js src/utils/tray-icon-generator.js",
    "build": "electron-builder",
    "build:nsis": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable"
  },
  "keywords": [
    "network",
    "speed",
    "monitor",
    "bandwidth",
    "latency",
    "ping",
    "windows-11",
    "windows-10",
    "taskbar-widget",
    "system-tray",
    "traffic-monitor",
    "open-source",
    "electron"
  ],
  "author": "Anujraj",
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.anujraj.netmeter",
    "productName": "NetMeter",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NetMeter",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
